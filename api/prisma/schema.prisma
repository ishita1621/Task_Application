generator client {
    provider = "prisma-client"
    output   = "../src/generated"
}

datasource db {
    provider = "postgresql"
}

model User {
    id         Int      @id @default(autoincrement())
    firstName  String
    middleName String?
    lastName   String
    email      String   @unique
    password   String
    createdAt  DateTime @default(now())
}
